MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/zawamu-properties?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
PORT=5000
# Comma-separated emails of EXISTING trusted owner accounts. Empty = deny all admin access.
# Compare against stored user email, never client-supplied claims. Do not expose in frontend env.
ADMIN_EMAILS=

# Trusted HTTPS website origin for property enquiry AND saved-search alert links.
# Local HTTP localhost origins are accepted only for disposable/development rehearsal.
FRONTEND_URL=https://www.example.com

# Number of trusted reverse-proxy hops (0 disables proxy trust). Set only when each
# configured proxy overwrites/appends forwarding headers as documented in README.
TRUST_PROXY_HOPS=0

# Outbound SMTP for contact enquiries and property alerts. Leave blank until approved.
# Port must be numeric (1-65535), secure true/false; user/password must be paired.
# No scheduler is installed; do not invoke the owner alert trigger without approval.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Approved business recipient is intentionally TBD; set only after approval.
CONTACT_NOTIFICATION_EMAIL=
